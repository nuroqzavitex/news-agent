# Sao chép thành .env rồi sửa. Docker Compose tự đọc file .env ở thư mục gốc.

# Agent
AGENT_ID=team-08-news
GROUP_ID=team-08
AGENT_PUBLIC_ENDPOINT=http://localhost:8008   # khi deploy: địa chỉ public, KHÔNG dùng localhost

# Hạ tầng (local | remote). Remote sẽ có khi các nhóm Team 1–4 công bố API.
REGISTRY_MODE=local
REGISTRY_URL=
BROKER_MODE=local
BROKER_URL=
IDENTITY_MODE=local
IDENTITY_URL=
IDENTITY_CLIENT_SECRET=
LOCAL_SHARED_SECRET=dev-shared-secret
TRACER_MODE=local
TRACER_URL=

# Data (chạy ngoài Docker; trong compose đã được ghi đè)
DATABASE_URL=postgresql+asyncpg://news:news@localhost:5432/news
REDIS_URL=redis://localhost:6379/0

# AI: optional. Without a key the agent uses non-LLM fallbacks; after adding one, run `docker compose up -d`
# and the enricher processes the existing articles too.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2   # changing this model requires re-embedding every article

# Pipeline
CRAWL_INTERVAL_S=600

# Dashboard
ADMIN_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000

# Dev
FAULTS_ENABLED=true
